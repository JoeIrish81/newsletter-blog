# Copia in `.env` (gitignored) e riempi.

# Token GoHighLevel con permesso di SCRITTURA sulle email (scope emails/builder).
# Serve solo per --push. Il token di sola lettura dell'attribuzione NON basta.
GHL_EMAIL_TOKEN=

# Location/sub-account dove creare la newsletter (default: quello della tua ultima preview).
GHL_LOCATION_ID=65dgBotw4hBLniJ5BTL2

# (Opzionale) userId GHL, alcune installazioni lo richiedono come "updatedBy".
GHL_USER_ID=

# Chiave Anthropic per generare la copy con Claude (serve solo per --auto).
# Da: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Opzionale: modello (default claude-opus-5). Per risparmiare: claude-sonnet-5
CLAUDE_MODEL=
